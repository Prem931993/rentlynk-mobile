{
  "expo": {
    "name": "RentLynk",
    "slug": "rentlynk",
    "scheme": "rentlynk",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentlynk.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock RentLynk securely.",
        "NSCameraUsageDescription": "Take photos of payment proof and maintenance issues.",
        "NSPhotoLibraryUsageDescription": "Attach payment screenshots and photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rentlynk.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sharing",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#041634",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock RentLynk securely."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach payment screenshots and photos.",
          "cameraPermission": "Take photos of payment proof and maintenance issues."
        }
      ],
      "expo-status-bar"
    ],
    "backgroundColor": "#041634",
    "extra": {
      "eas": {
        "projectId": "f75ff844-a6be-4114-9046-b1f9bd18ed3d"
      }
    }
  }
}